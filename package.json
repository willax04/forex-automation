{
  "name": "social-media-automation-app",
  "version": "1.0.0",
  "description": "Mobile-first web app for social media content management and lead tracking",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server.js",
    "client:dev": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server.js",
    "install:client": "cd client && npm install",
    "install:all": "npm install && npm run install:client"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "sqlite3": "^5.1.6",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.3.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  },
  "keywords": ["social media", "automation", "content management", "lead tracking"],
  "author": "Engine AI",
  "license": "MIT"
}
